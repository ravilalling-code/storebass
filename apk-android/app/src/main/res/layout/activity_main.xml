<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B1B3D">

    <!-- 1. WebView con Pull-to-Refresh -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <WebView
            android:id="@+id/webView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#0B1B3D" />

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- 2. Pantalla de Carga (Splash suave con logo StoreBass) -->
    <LinearLayout
        android:id="@+id/loadingLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:background="#0B1B3D"
        android:padding="24dp">

        <ImageView
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:src="@mipmap/ic_launcher"
            android:contentDescription="StoreBass Logo"
            android:layout_marginBottom="24dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="STOREBASS"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Monitor de Pedidos"
            android:textColor="#93C5FD"
            android:textSize="13sp"
            android:layout_marginBottom="28dp" />

        <ProgressBar
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:indeterminate="true"
            android:indeterminateTint="#F59E0B" />
    </LinearLayout>

    <!-- 3. Pantalla de Error / Conexión (Evita pantalla blanca) -->
    <LinearLayout
        android:id="@+id/errorLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:background="#0B1B3D"
        android:padding="32dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:src="@mipmap/ic_launcher"
            android:contentDescription="StoreBass Logo"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="STOREBASS"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <TextView
            android:id="@+id/errorTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No se pudo conectar al servidor de Vercel.\nVerifica tu conexión a internet o configura la URL de tu tienda."
            android:textColor="#CBD5E1"
            android:textSize="13sp"
            android:textAlignment="center"
            android:gravity="center"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/btnRetry"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Reintentar Conexión"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#0052CC"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnChangeUrl"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Configurar URL de Vercel"
            android:textStyle="bold"
            android:textColor="#CBD5E1"
            android:backgroundTint="#1E293B" />
    </LinearLayout>

</FrameLayout>
